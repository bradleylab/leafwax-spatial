# Ignore everything at root
/*
/*/

# Allowlist top-level code / config / infra
!*.R
!*.stan
!*.py
!*.sh
!Makefile

# Allowlist the scripts/ helpers subdir
!scripts/
!scripts/**

# Allowlist SLURM submission scripts
!slurm/
!slurm/*.sh
!.gitignore
!README.md
!LICENSE
!CLAUDE.md
!config.yaml
!Dockerfile
!.github/
!.github/**

# Allowlist canonical input dataset
!input_data/
!input_data/global_data_c29.csv

# Allowlist new project subtrees
!manuscript/
!manuscript/**
!data/
!data/**
!archive/
!archive/**

# Within those subtrees, still exclude junk
**/.DS_Store
**/.Rhistory
**/.RData
**/.claude/
**/.ruff_cache/
**/__pycache__/
**/*.bak
**/*.bak_*
**/scheduled_tasks.lock

# Root-level working files to keep out
check_all_knots.R
results/

# Figure scripts now write directly into manuscript/figures/main_figs/
# or manuscript/figures/supplement_figs/, so figure_code/ itself stays
# code-only — except for these scratch files that a couple of scripts
# write next to themselves (Figure 1's comparison CSV, R's fallback
# Rplots.pdf).
manuscript/figure_code/Rplots.pdf
manuscript/figure_code/Figure1_comparison_table.csv

# model_analysis/ is the scratch tree where extract_*.R / 5b drop their
# companion CSVs. Gitignored results/ already covers the April run data;
# the CSVs land here on a regenerate pass.
model_analysis/

# Working manuscript drafts (.docx). Keep the directory structure local;
# don't version binary Word files in git.
manuscript/drafts/
