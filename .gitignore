# Ignore everything at root
/*
/*/

# Allowlist top-level code / config / infra
!*.R
!*.stan
!*.py
!*.sh
!.gitignore
!README.md
!LICENSE
!config.yaml
!Dockerfile
!.github/
!.github/**

# Allowlist canonical input dataset
!input_data/
!input_data/global_data_c29.csv

# Allowlist new project subtrees
!manuscript/
!manuscript/**
!data/
!data/**
!archive/
!archive/**

# Within those subtrees, still exclude junk
**/.DS_Store
**/.Rhistory
**/.RData
**/.claude/
**/.ruff_cache/
**/__pycache__/
**/*.bak
**/*.bak_*
**/scheduled_tasks.lock

# Root-level working files to keep out
check_all_knots.R
results/
