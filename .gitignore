# Ignore everything at root
/*
/*/

# Allowlist top-level code / config / infra
!*.R
!*.stan
!*.py
!*.sh
!Makefile

# Allowlist the scripts/ helpers subdir
!scripts/
!scripts/**

# Allowlist SLURM submission scripts
!slurm/
!slurm/*.sh
!.gitignore
!README.md
!LICENSE
!CLAUDE.md
!config.yaml
!Dockerfile
!.github/
!.github/**

# Allowlist canonical input dataset
!input_data/
!input_data/global_data_c29.csv

# Allowlist new project subtrees
!manuscript/
!manuscript/**
!data/
!data/**
!archive/
!archive/**

# Within those subtrees, still exclude junk
**/.DS_Store
**/.Rhistory
**/.RData
**/.claude/
**/.ruff_cache/
**/__pycache__/
**/*.bak
**/*.bak_*
**/scheduled_tasks.lock

# Root-level working files to keep out
check_all_knots.R
results/

# Figure scratch outputs live inside manuscript/figure_code/ while scripts
# run there (cwd-coupled). The Makefile copies the canonical outputs into
# manuscript/figures/main_figs/; the scratch copies are ephemeral and
# should not be committed.
manuscript/figure_code/*.pdf
manuscript/figure_code/*.png
manuscript/figure_code/main/
manuscript/figure_code/Rplots.pdf

# Likewise the model_analysis/ scratch tree where extract_*.R / 5b drop
# their CSVs — gitignored results/ already covers the April run, but the
# CSV siblings for the table audit land here on a regenerate pass.
model_analysis/
